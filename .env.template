# Billator environment template
# Copy to .env.local for local development, or .env on the Pi.
# NOTE: most configuration is now DB-driven via the /settings UI. Only
# deployment-critical values live in env.

# ========================
# STORAGE
# ========================
# Supported modes: sqlite | filesystem | supabase
# sqlite is the default: a single file at DB_PATH (Docker-volume backed).
STORAGE_MODE=sqlite
# For local dev the default (./data/billator.db) is fine. The Pi container
# sets DB_PATH to /app/data/billator.db via docker-compose.
# DB_PATH=./data/billator.db

# ========================
# SECRETS
# ========================
# Key used to encrypt Gmail credentials at rest in the DB (>=16 chars).
# Generate with: openssl rand -hex 32
GMAIL_ENCRYPTION_KEY=change-me-to-a-32-char-secret

# ========================
# EXPERT: storage fallbacks (optional)
# ========================
# Supabase is supported but not required for a home-server deployment.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# ========================
# TARIFF/APP OVERRIDES (optional, quick env tweaks)
# ========================
# Most tariff values are editable in /settings → Tariffs. These env overrides
# take precedence only until the DB value is set.
# TARIFF_ENERGY_RATE_VT=0.097189
# TARIFF_ENERGY_RATE_NT=0.047688
# TARIFF_OVERAGE_MULTIPLIER=1.35
# TARIFF_OVERAGE_THRESHOLD_KWH=3000
