# Copy to .env.deploy (gitignored) and edit for your Raspberry Pi.
# These are read by scripts/deploy.sh — they never leave your machine.

# Pi hostname (mDNS) or IP address
PI_HOST=pi5.local

# SSH user on the Pi
PI_USER=pi

# Destination path on the Pi (a directory that will be created)
PI_PATH=~/billator

# Host port for Billator. IMPORTANT: on this Pi, port 3000 is used by Grafana,
# so use a different port here (e.g. 3100).
BILLATOR_PORT=3100
